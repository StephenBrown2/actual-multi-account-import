PORT=3000
# HTTP port for this importer service (web UI + API). Change if 3000 is occupied.

ACTUAL_SERVER_URL=http://localhost:5006
# Base URL of your Actual server (self-hosted or desktop bridge endpoint).

ACTUAL_PASSWORD=
# Your Actual server password used for API login.
# Set this OR ACTUAL_SESSION_TOKEN (token takes precedence in some setups).

ACTUAL_SESSION_TOKEN=
# Optional API session token for Actual auth instead of password.
# You can capture this from an authenticated Actual API session.

ACTUAL_DATA_DIR=/data
# Local cache/state directory used by @actual-app/api for downloaded budget data.
# In Docker this is best mounted to a persistent volume.

# Budget selector rules:
# 1) Set exactly one of ACTUAL_BUDGET_ID, ACTUAL_BUDGET_NAME, or ACTUAL_SYNC_ID.
# 2) Set selectors in one place only: environment variables OR CLI flags, not both.

ACTUAL_BUDGET_ID=
# Optional exact local budget ID to load.
# Use this when multiple budgets exist and you want deterministic selection.

ACTUAL_BUDGET_NAME=
# Optional budget name to load (used when ACTUAL_BUDGET_ID is not set).
# Example: "Personal" or "Household".

ACTUAL_SYNC_ID=
# Optional cloud sync ID (group ID) to download/load the budget automatically.
# Useful if budget isn't present yet in ACTUAL_DATA_DIR.

ACTUAL_IMPORT_DEBUG=
# Set to 1 or true to enable debug logging (connection and budget load flow) to stderr.
# Use when troubleshooting "No budget loaded" or import failures.
