{
  "name": "actual-multi-account-import",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone multi-account transaction importer for Actual Budget",
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "server": "npm run web:build && tsx src/server.ts",
    "server:api": "tsx src/server.ts",
    "web:dev": "vite --host",
    "web:build": "vite build",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check"
  },
  "dependencies": {
    "@actual-app/api": "^26.2.1",
    "commander": "^14.0.3",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
